{
  "name": "blokdust",
  "private": true,
  "version": "2.0.1",
  "description": "BlokDust 2: a visual, physics-driven music playground for web, VST3, AU and standalone.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "bd": "node tools/bd.ts",
    "index": "node tools/bd.ts index",
    "check": "node tools/bd.ts index --check && node tools/bd.ts codegen --check",
    "codegen": "node tools/bd.ts codegen",
    "web:dev": "pnpm -C web dev",
    "web:build": "node tools/bd.ts wasm build && pnpm -C web build",
    "web:typecheck": "pnpm -C web typecheck",
    "test:web": "node tests/e2e/library-smoke.ts",
    "engine:configure": "cmake --preset dev",
    "engine:build": "cmake --build --preset dev -j 8",
    "test:engine": "ctest --preset dev",
    "ci": "node tools/bd.ts ci",
    "test:worklet": "node tests/e2e/worklet-golden.ts",
    "test:stage": "node tests/e2e/stage-e2e.ts",
    "test:e2e": "node tests/e2e/build-and-hear.ts",
    "test:ui-regressions": "node tests/e2e/ui-regressions.ts",
    "test:sharing": "node tests/e2e/sharing.ts",
    "test:sharing:base": "node tests/e2e/sharing.ts --base",
    "server:typecheck": "pnpm -C server typecheck",
    "test:mpe": "node tests/mpe/run.ts"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "pixelmatch": "7.2.0",
    "playwright": "1.64.1",
    "pngjs": "7.0.0"
  }
}
