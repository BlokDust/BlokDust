{
  "version": 6,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Debug + tests",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BLOKDUST_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release + tests",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BLOKDUST_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "asan",
      "displayName": "Debug + ASan/UBSan",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BLOKDUST_BUILD_TESTS": "ON",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=all",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "wasm",
      "displayName": "WebAssembly (Emscripten, Release)",
      "binaryDir": "${sourceDir}/build/wasm",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BLOKDUST_BUILD_TESTS": "OFF",
        "BLOKDUST_BUILD_TOOLS": "OFF"
      }
    },
    {
      "name": "plugin-release",
      "displayName": "JUCE plugin for the installers (Release, universal, macOS 11+)",
      "binaryDir": "${sourceDir}/build/plugin-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BLOKDUST_BUILD_TESTS": "OFF",
        "BLOKDUST_BUILD_TOOLS": "ON",
        "BLOKDUST_BUILD_PLUGIN": "ON",
        "BLOKDUST_UNIVERSAL": "ON"
      }
    },
    {
      "name": "plugin",
      "displayName": "JUCE plugin (Release)",
      "binaryDir": "${sourceDir}/build/plugin",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BLOKDUST_BUILD_TESTS": "OFF",
        "BLOKDUST_BUILD_TOOLS": "ON",
        "BLOKDUST_BUILD_PLUGIN": "ON"
      }
    },
    {
      "name": "plugin-ios-sim",
      "displayName": "iPadOS AUv3 + app for the Simulator (CHG-0025; Xcode generator)",
      "binaryDir": "${sourceDir}/build/plugin-ios-sim",
      "generator": "Xcode",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_SYSROOT": "iphonesimulator",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "BLOKDUST_BUILD_TESTS": "OFF",
        "BLOKDUST_BUILD_TOOLS": "ON",
        "BLOKDUST_BUILD_PLUGIN": "ON"
      }
    },
    {
      "name": "plugin-ios",
      "displayName": "iPadOS AUv3 + app for an iPad (CHG-0025 task 10; Xcode generator, automatic signing with the team in local config)",
      "binaryDir": "${sourceDir}/build/plugin-ios",
      "generator": "Xcode",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_SYSROOT": "iphoneos",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "BLOKDUST_BUILD_TESTS": "OFF",
        "BLOKDUST_BUILD_TOOLS": "ON",
        "BLOKDUST_BUILD_PLUGIN": "ON",
        "CMAKE_XCODE_ATTRIBUTE_DEVELOPMENT_TEAM": "$env{BLOKDUST_APPLE_TEAM_ID}",
        "CMAKE_XCODE_ATTRIBUTE_CODE_SIGN_STYLE": "Automatic"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "wasm",
      "configurePreset": "wasm"
    },
    {
      "name": "plugin",
      "configurePreset": "plugin"
    },
    {
      "name": "plugin-release",
      "configurePreset": "plugin-release"
    },
    {
      "name": "plugin-ios-sim",
      "configurePreset": "plugin-ios-sim",
      "configuration": "Release"
    },
    {
      "name": "plugin-ios",
      "configurePreset": "plugin-ios",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
