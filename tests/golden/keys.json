{
  "description": "A MIDI controller plays two tones (one through a filter): notes, legato overlap, transpose change.",
  "render": { "seconds": 4, "sampleRate": 48000 },
  "patch": {
    "format": "blokdust.patch", "version": 2, "seed": 1,
    "blocks": [
      { "id": "midi", "type": "input.midi-controller", "x": 0, "y": 0 },
      { "id": "lead", "type": "source.tone", "x": 3, "y": 0, "params": { "waveform": 3 } },
      { "id": "sub", "type": "source.tone", "x": -3, "y": 0, "params": { "waveform": 0, "transpose": -12 } },
      { "id": "filter", "type": "fx.filter", "x": 6, "y": 2, "params": { "frequency": 1200, "gain": 9 } }
    ]
  },
  "script": [
    { "atSample": 0, "op": "noteOn", "note": 60 },
    { "atSample": 24000, "op": "noteOn", "note": 64 },
    { "atSample": 36000, "op": "noteOff", "note": 64 },
    { "atSample": 48000, "op": "noteOff", "note": 60 },
    { "atSample": 60000, "op": "set", "block": "midi", "param": "transpose", "value": 1 },
    { "atSample": 72000, "op": "noteOn", "note": 67, "velocity": 0.5 },
    { "atSample": 144000, "op": "noteOff", "note": 67 }
  ]
