# Copy to ~/.config/blokdust/config.env, outside every checkout; chmod 600.
# Process environment overrides this file. Blank values require local setup.
# Keep passwords, SSH keys and signing keys in their credential stores.
CLOUDFLARE_ACCOUNT_ID=
BLOKDUST_WORKERS_SUBDOMAIN=
BLOKDUST_STAGING_PUBLIC_URL=
BLOKDUST_PRODUCTION_PUBLIC_URL=
BLOKDUST_STAGING_DATABASE_ID=
BLOKDUST_PRODUCTION_DATABASE_ID=
BLOKDUST_STAGING_TURNSTILE_SITE_KEY=
BLOKDUST_PRODUCTION_TURNSTILE_SITE_KEY=
# Usage analytics (SHARING-0010), optional. Access: https://<team>.cloudflareaccess.com and the /admin app's AUD tag.
# ANALYTICS_RATE: 0 (off) … 1; production defaults to 0. The dashboard's query token goes in ./analytics_token.
BLOKDUST_STAGING_ACCESS_TEAM_DOMAIN=
BLOKDUST_STAGING_ACCESS_AUD=
BLOKDUST_PRODUCTION_ACCESS_TEAM_DOMAIN=
BLOKDUST_PRODUCTION_ACCESS_AUD=
BLOKDUST_STAGING_SENTRY_DSN=
BLOKDUST_PRODUCTION_SENTRY_DSN=
BLOKDUST_PRODUCTION_ANALYTICS_RATE=
BLOKDUST_TEST_HOST=
BLOKDUST_VM_DIR=
BLOKDUST_VM_USER=
BLOKDUST_VM_SSH_PORT=
BLOKDUST_VM_RAM=
BLOKDUST_VM_CPUS=
BLOKDUST_VM_XRES=
BLOKDUST_VM_YRES=
BLOKDUST_VM_SERIAL=
BLOKDUST_SIGNING_IDENTITY=
BLOKDUST_INSTALLER_IDENTITY=
BLOKDUST_APPLE_TEAM_ID=
BLOKDUST_NOTARY_PROFILE=
